public class Main 
{
    public static int uva(int a,int b)
    {
        int r;
        while(b!=0)
        {
            r=a%b;
            a=b;
            b=r;
        }
        return a;
    }
   public static void main(String[]args)
    {
        int[]a={8,10,4,15,12,18,20};
        int gcd=a[0];
        for(int i=1;i<7;i++)
        {
            gcd=uva(gcd,a[i]);
        }
        System.out.print("the gcd is"+gcd);
    }
}
 
