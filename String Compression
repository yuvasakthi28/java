import java.util.Scanner;
public class Main
{
    public static void main(String[] args)
    {
        String x="aabbccccddddeeffggg";
        int c=1;
        String y="";
        int n=x.length();
        for(int i=0;i<n;i++)
        {
            if(i+1<n&&x.charAt(i)==x.charAt(i+1))
            {
                c++;
            }
            else
            {
            y=y+x.charAt(i);
            y=y+(Integer.toString(c));
            c=1;
            }
            
        }
        System.out.println(y);
    }
}
