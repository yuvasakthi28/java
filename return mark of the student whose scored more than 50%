import java.util.*;
public class Main 
{
    public static void main(String[]args)
    {
        Scanner q=new Scanner(System.in);
        int[]marks=new int[5];
        String[]name=new String[5];
        for(int i=0;i<5;i++)
        {
            System.out.println("Enter marks & Enter name of stu"+(i+1));
            marks[i]=q.nextInt();
            q.nextLine();
            name[i]=q.nextLine();
        }
        System.out.println("____");
        int s=1;
        for(int i=0;i<5;i++)
        {
            if(marks[i]>50)
            {
                System.out.println(s+" "+name[i]+" has scored "+marks[i]);
                s++;
            }
        }
    }
}
