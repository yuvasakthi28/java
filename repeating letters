public class Main
{
    public static void main(String[] args)
    {
        String a="yuvasakthi";
        int n=a.length();
        for(int i=0;i<n;i++)
        {
            for(int j=0; j<i; j++)
            {
                if(a.charAt(i)==a.charAt(j))
                {
                    System.out.println(a.charAt(i));
                    return;
                }
            }
        }
        
    }
}
