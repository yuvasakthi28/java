public class Main
{
    public static int uva(int s)
    {
        int a=0;
        while(s<0)
        {
            a=a+(s%10);
            s=s/10;
        }
        return a;
    }
    public static boolean prime(int i)
    {
        if(i==1)
        return false;
        for (int j=2;j<i;j++)
        {
            if (i%j==0)
            return false;
        }
        return true;
    }
    public static void main(String[] args)
    {
        int s;
        for(int i=100;i<1000;i++)
        {
            s=uva(i);
            if(prime(i) && prime(s))
            System.out.println(i+" ");
        }
        
    }
}
